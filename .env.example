# ===== 模型 A：OpenAI Responses 协议 =====
MODEL_A_ALIAS=deepseek-v4-pro
MODEL_A_PROTOCOL=openai_responses
# base_url 填到"含版本号的根"，网关自动拼 /responses
MODEL_A_BASE_URL=https://api.openai.com/v1
MODEL_A_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
MODEL_A_UPSTREAM_MODEL=gpt-4o-mini
MODEL_A_RPM=60
MODEL_A_BURST=10
MODEL_A_TIMEOUT_S=60

# ===== 模型 B：Anthropic Messages 协议 =====
MODEL_B_ALIAS=deepseek-v4-flash
MODEL_B_PROTOCOL=anthropic_messages
# 网关自动拼 /v1/messages
MODEL_B_BASE_URL=https://api.anthropic.com
MODEL_B_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
MODEL_B_UPSTREAM_MODEL=claude-sonnet-4-5
MODEL_B_RPM=30
MODEL_B_BURST=5
MODEL_B_TIMEOUT_S=60

# ===== 网关自身 =====
GATEWAY_API_KEY=                 # 留空=不校验鉴权；填了则要求 Authorization: Bearer <key>
MAX_ATTEMPTS=3                   # 最多 3 次尝试（1 次正常 + 2 次重试）
RETRY_BASE_DELAY=0.5
RETRY_MAX_DELAY=8
PROMPTS_DIR=prompts
LOG_DIR=logs
ENABLE_ADMIN=true                # 验证脚本需要用 /admin 临时改上游地址
PORT=8000
LOG_LEVEL=INFO
